{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["icn1"],
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{seed/**,public/index.html}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
